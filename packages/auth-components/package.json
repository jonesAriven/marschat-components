{
  "name": "@marschat/auth-components",
  "version": "0.6.2",
  "description": "MarsChat 统一认证公共组件库 - SSO 单点登录、静默免登、统一登出(SLO)、会话监视、统一用户管理、RBAC 权限(usePermissions/useMenus/PermissionGate)、OIDC PKCE",
  "type": "module",
  "main": "./dist/marschat-auth-components.es.js",
  "module": "./dist/marschat-auth-components.es.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/marschat-auth-components.es.js",
      "require": "./dist/marschat-auth-components.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css",
    "./umd": "./dist/marschat-auth-core.umd.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && vite build --config vite.umd.config.ts && vue-tsc -p tsconfig.build.json",
    "build:es": "vite build",
    "build:umd": "vite build --config vite.umd.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.4.21",
    "@element-plus/icons-vue": "^2.3.1"
  },
  "peerDependencies": {
    "element-plus": "^2.6.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "typescript": "^5.4.2",
    "vite": "^5.1.6",
    "vue-tsc": "^2.0.6"
  },
  "keywords": [
    "sso",
    "oidc",
    "auth",
    "login",
    "pkce",
    "marschat"
  ],
  "author": "MarsChat DevTeam",
  "license": "MIT",
  "sideEffects": [
    "./dist/style.css",
    "./dist/*.css"
  ]
}
