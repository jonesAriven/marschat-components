{"name": "marschat-components", "version": "0.1.0", "private": true, "description": "MarsChat 公共组件库 Monorepo - 统一认证、核心工具、前端公共包", "scripts": {"build": "pnpm -r --filter './packages/*' build", "build:auth": "pnpm --filter @marschat/auth-components build", "build:frontend-common": "pnpm --filter @marschat/frontend-common build", "build:java": "powershell -File scripts/build-all.ps1 -SkipNpm", "build:all": "powershell -File scripts/build-all.ps1", "lint": "eslint 'packages/*/src/**/*.{ts,vue}'", "lint:fix": "eslint 'packages/*/src/**/*.{ts,vue}' --fix", "test": "pnpm -r test", "test:java": "cd java/common-core && mvn test && cd ../auth-core && mvn test", "changeset": "changeset", "version": "changeset version", "publish": "changeset publish", "push": "powershell -File scripts/push-all.ps1"}, "devDependencies": {"@changesets/cli": "^2.27.1", "@typescript-eslint/eslint-plugin": "^7.0.0", "@vue/eslint-config-typescript": "^13.0.0", "eslint": "^8.57.0", "typescript": "^5.4.2", "prettier": "^3.2.0", "eslint-config-prettier": "^9.0.0"}, "engines": {"node": ">=18.0.0"}, "packageManager": "pnpm@9.15.9"}